# deploy/logs — NÃO usar "deploy/logs/*" pois ignoraria os subdiretórios
# inteiros, impedindo que as exceções de README abaixo funcionem.
# Cada subdiretório tem seus próprios padrões de conteúdo.
deploy/logs/*.log
deploy/logs/gunicorn/gunicorn*
deploy/logs/history/history*
deploy/logs/nginx/access*
deploy/logs/nginx/error*
deploy/logs/supervisor/err*
deploy/logs/supervisor/out*
# email não tem padrão próprio no original — ignorar tudo exceto README
deploy/logs/email/*

