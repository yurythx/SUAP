{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "type": "local"
    },
    "gitlab": {
      "command": [
        "npx",
        "-y",
        "@zereight/mcp-gitlab",
        "--token=token-gitlab",
        "--api-url=https://gitlab.ifrn.edu.br/api/v4"
      ],
      "type": "local"
    },
    "sentry": {
      "command": [
        "npx",
        "-y",
        "@sentry/mcp-server",
        "--access-token=token-sentry",
        "--host=sentry.ifrn.edu.br",
        "--disable-skills=seer"
      ],
      "type": "local"
    }
  }
}
