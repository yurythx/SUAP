# =============================================================================
# .env de desenvolvimento do SUAP
# Copie para a raiz como .env:  cp .env.dev.sample .env
# Consumido por docker/docker-compose.dev.yml e pelo Makefile (make run).
# Descrição de cada variável: docs/variaveis-ambiente.md
# =============================================================================

# --- Ambiente / aplicação --------------------------------------------------
SUAP_ENVIRONMENT=dev
DEBUG=True
# Em dev pode manter este valor; troque por uma chave própria fora de dev.
SECRET_KEY=xru6&52s_b&vv5%!f@hyd)m&059z^x54q(s-=2-x9b1up(xiwn
TZ=America/Fortaleza

# --- Banco de dados (Postgres) ---------------------------------------------
DATABASE_NAME=suap
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Cache / sessão (Redis) ------------------------------------------------
# OBRIGATÓRIO: sem USE_REDIS=True as *_LOCATION abaixo são ignoradas e o
# container redis fica ocioso (cache em memória / sessão em DB).
USE_REDIS=True
REDIS_LOCATION=redis://redis:6379/1
SESSION_LOCATION=redis://redis:6379/2

# --- Tarefas assíncronas (Celery) ------------------------------------------
# OBRIGATÓRIO: sem USE_CELERY=True os containers celery/celery-beat não
# despacham tarefas (as URLs do broker/result são ignoradas).
USE_CELERY=True
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4
CELERY_QUEUE=geral
# Painel Flower (serviço opcional). Formato usuario:senha do basic auth.
FLOWER_BASIC_AUTH=usuario:senha

# --- E-mail (Mailhog) — recomendado em dev ---------------------------------
# Captura os e-mails enviados; UI em http://localhost:8025
EMAIL_HOST=mail
EMAIL_PORT=1025

# --- Armazenamento de arquivos (MinIO/S3) ----------------------------------
# Opt-in: o storage padrão em dev é o filesystem. Estas credenciais também
# inicializam o MinIO (MINIO_ROOT_USER/PASSWORD) no compose.
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=miniopassword

# --- Imagens / Docker ------------------------------------------------------
CONTAINERS=1
SUAP_IMAGE=gitlab.instituicao.edu.br:4567/cosinf/suap
SUAP_PDF_IMAGE=gitlab.instituicao.edu.br:4567/cosinf/suap-pdf:latest
SUAP_PDF_VOLUME_PATH=/opt/suap-pdf/
SUAP_AI_IMAGE=gitlab.instituicao.edu.br:4567/cosinf/suap-ai:latest
NGINX_SERVER_NAME=suap1.instituicao.local suap.instituicao.edu.br
