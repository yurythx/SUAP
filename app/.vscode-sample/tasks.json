{
  "tasks": [
    {
      "command": "pre-commit run --from-ref origin/master --to-ref HEAD",
      "label": "Pré-Commit (SUAP)",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "type": "shell"
    },
    {
      "command": "python manage.py run",
      "label": "Run (SUAP)",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "type": "shell"
    },
    {
      "command": "python manage.py shell",
      "label": "Shell (SUAP)",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "type": "shell"
    },
    {
      "command": "cp ${workspaceFolder}/.vscode/suap.code-snippets ~/Library/Application\\ Support/Code/User/snippets/",
      "label": "Install Snippets / MAC OS (SUAP)",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "type": "shell"
    },
    {
      "command": "cp ${workspaceFolder}/.vscode/suap.code-snippets ~/.config/Code/User/snippets/",
      "label": "Install Snippets / Linux (SUAP)",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "type": "shell"
    }
  ],
  "version": "2.0.0"
}
