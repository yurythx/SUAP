# Minimal env para subir docker/dev/docker-compose.yml
# Copie para docker/dev/.env e ajuste os caminhos/credenciais.

COMPOSE_PROJECT_NAME=suap

# Rede dos containers
DOCKER_IPAM_CONFIG_GATEWAY_IP=172.30.0.1
DOCKER_IPAM_CONFIG_SUBNET=172.30.0.0/24

# VPN (compose externo)
DOCKER_VPN_WORKDIR=/ABS/PATH/TO/suap-analytics/docker/vpn
DOCKER_VPN_IP=172.30.0.99

# Sdocker (scripts montados no container db)
# Deve conter: $SDOCKER_WORKDIR/scripts/db_entrypoint.sh
SDOCKER_WORKDIR=/ABS/PATH/TO/sdocker

# App web
WORK_DIR=/opt/suap
APP_PORT=8000
DEV_IMAGE=suap-local:dev
SUAP_IMAGE=gitlab.ifrn.edu.br:4567/cosinf/suap
# Estratégia para base `${SUAP_IMAGE}:base` (recomendado: local para alinhar com pyproject.toml)
BASE_IMAGE_SOURCE=local

# Usuário host/container
# macOS: Users | Linux: home
USER_BASE_DIR_NAME=Users
USER_NAME=your_user
USER_UID=1000
USER_GID=1000

# Banco
DATABASE_NAME=suap_pequeno_mascarado
DATABASE_USER=dev
DATABASE_PASSWORD=change_me
DATABASE_HOST=vpn
DATABASE_PORT=25432
DATABASE_DUMP_DIR=./dump

# db entrypoint exige PEM montado em /tmp/dbuser.pem
LOCAL_DBUSER_PEM_PATH=/ABS/PATH/TO/ifrn/scripts/config/dbuser.pem
DBUSER_PEM_PATH=/tmp/dbuser.pem

# Rotas/hosts para ambiente com VPN
ETC_HOSTS="
teresina.ifrn.local:10.22.0.144
florania.ifrn.local:10.22.1.244
"
ROUTE_NETWORK=10.22.0.0/16

# Recomendadas para build/pull
GITLAB_USER=your_gitlab_user
GITLAB_PASSWORD=your_gitlab_token_or_password

# Recomendadas para filas/redis
CELERY_QUEUE=geral
REDIS_EXTERNAL_PORT=6379
PGADMIN_PORT=8001
PGADMIN_EXTERNAL_PORT=8001
