{
  "description": "Guardrails do SUAP (núcleo em .agents/hooks/) para edições, commits e merge requests feitos pelo Codex.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/check_complexity.py\"",
            "statusMessage": "Checando complexidade das funções tocadas",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "^apply_patch$"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/register_mr_time_spent.py\"",
            "statusMessage": "Registrando tempo de trabalho no MR",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "^Bash$|create_merge_request|update_merge_request"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/protect_env.py\"",
            "statusMessage": "Verificando proteção de arquivos .env",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^apply_patch$"
      },
      {
        "hooks": [
          {
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_commit.py\"",
            "statusMessage": "Preparando gate de commit do SUAP",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ]
  }
}
