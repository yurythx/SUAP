                        "maxLength": 255,
                        "pattern": "^[0-9]{1,}\\.[0-9]{1,}\\.[a-f0-9]{12,}$",
                        "type": "string"
                      },
                      "CodigoEMECCurso": {
                        "description": "Número inteiro positivo de 32 bits",
                        "pattern": "^([0-9]{1,9}|1[0-9]{9}|2(0[0-9]{8}|1([0-3][0-9]{7}|4([0-6][0-9]{6}|7([0-3][0-9]{5}|4([0-7][0-9]{4}|8([0-2][0-9]{3}|3([0-5][0-9]{2}|6([0-3][0-9]|4[0-7])))))))))$",
                        "type": "string"
                      },
                      "DataEmissao": {
