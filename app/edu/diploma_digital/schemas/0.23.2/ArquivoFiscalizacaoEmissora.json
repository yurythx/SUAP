        "required": [
          "data"
        ]
      },
      "if": {
        "properties": {
          "op": {
            "const": "insert"
          }
        }
      },
      "properties": {
        "data": {
          "additionalProperties": true,
          "description": "Dados do arquivo de fiscalização da emissora",
