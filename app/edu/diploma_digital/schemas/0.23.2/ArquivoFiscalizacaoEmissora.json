                        "maxLength": 255,
                        "pattern": "^https://",
                        "type": "string"
                      },
                      "URLXMLdeRegistroAcademico": {
                        "description": "URL genérico com HTTPS",
                        "format": "uri",
                        "maxLength": 255,
                        "pattern": "^https://",
                        "type": "string"
