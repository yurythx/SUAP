                                "CodigoDiploma"
                              ]
                            }
                          },
                          {
                            "not": {
                              "required": [
                                "CPFDetentor"
                              ]
                            }
                          },
                          {
                            "not": {
                              "required": [
                                "CodigoEMECCurso"
                              ]
