                          },
                          {
                            "not": {
                              "required": [
                                "DataEmissao"
                              ]
                            }
                          },
                          {
                            "not": {
                              "required": [
                                "DataRegistro"
                              ]
                            }
                          },
                          {
                            "not": {
                              "required": [
                                "DataRegistro"
                              ]
                            }
                          }
