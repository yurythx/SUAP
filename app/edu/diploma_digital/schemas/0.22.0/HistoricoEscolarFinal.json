{
  "$id": "http://example.com/HistoricoEscolarFinal.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TAtoRegulatorio": {
      "description": "Ato de regulação",
      "properties": {
        "Data": {
          "description": "Data do ato regulatório",
          "format": "date"
        },
        "DataPublicacao": {
          "description": "Data de publicação do ato regulatório",
          "format": "date"
        },
        "Numero": {
          "description": "Número do ato regulatório",
          "pattern": "^([0-9]+)(/[0-9a-zA-Z0-9_]+)*$",
          "type": "string"
        },
        "NumeroDOU": {
          "description": "Número do ato regulatório no diário oficial da união",
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "PaginaPublicacao": {
          "description": "Página de publicação do ato regulatório",
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "SecaoPublicacao": {
          "description": "Seção de publicação do ato regulatório",
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "Tipo": {
          "description": "Tipo do ato regulatório",
          "enum": [
            "Parecer",
            "Resolução",
            "Decreto",
            "Portaria",
            "Deliberação",
            "Despacho",
            "Lei Federal",
            "Lei Estadual",
            "Lei Municipal"
          ],
          "type": "string"
        },
        "VeiculoPublicacao": {
          "description": "Veículo de publicação do ato regulatório",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        }
      },
      "required": [
        "Tipo",
        "Numero",
        "Data"
      ],
      "type": "object"
    },
    "TAtoRegulatorioComOuSemEMEC": {
      "description": "Ato regulatório de reconhecimento",
      "oneOf": [
        {
          "properties": {
            "Data": {
              "description": "Data do ato regulatório",
              "format": "date"
            },
            "DataPublicacao": {
              "description": "Data de publicação do ato regulatório",
              "format": "date"
            },
            "Numero": {
              "description": "Número do ato regulatório",
              "pattern": "^(S/N)|(([0-9])[-0-9a-zA-Z0-9_/]*)$",
              "type": "string"
            },
            "NumeroDOU": {
              "description": "Número do ato regulatório no diário oficial da união",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "PaginaPublicacao": {
              "description": "Página de publicação do ato regulatório",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "SecaoPublicacao": {
              "description": "Seção de publicação do ato regulatório",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "Tipo": {
              "description": "Tipo do ato regulatório",
              "enum": [
                "Parecer",
                "Resolução",
                "Decreto",
                "Portaria",
                "Deliberação",
                "Despacho",
                "Lei Federal",
                "Lei Estadual",
                "Lei Municipal",
                "Ato Próprio"
              ],
              "type": "string"
            },
            "VeiculoPublicacao": {
              "description": "Veículo de publicação do ato regulatório",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            }
          },
          "required": [
            "Tipo",
            "Numero",
            "Data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "InformacoesTramitacaoEMEC": {
              "description": "Informações sobre a tramitação do processo e-MEC",
              "properties": {
                "DataCadastro": {
                  "description": "Data de abertura do processo e-MEC",
                  "format": "date"
                },
                "DataProtocolo": {
                  "description": "Data de emissão do protocolo e-MEC",
                  "format": "date"
                },
                "NumeroProcesso": {
                  "description": "Número do processo e-MEC",
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                },
                "TipoProcesso": {
                  "description": "Tipo do processo e-MEC",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                  "type": "string"
                }
              },
              "required": [
                "NumeroProcesso",
                "TipoProcesso",
                "DataCadastro",
                "DataProtocolo"
              ],
              "type": "object"
            }
          },
          "required": [
            "InformacoesTramitacaoEMEC"
          ],
          "type": "object"
        }
      ]
    },
    "TCNPJ": {
      "description": "Número do CNPJ sem separadores",
      "pattern": "^[0-9]{14}$",
      "type": "string"
    },
    "TDadosDiplomado": {
      "description": "Dados pessoais do aluno",
      "properties": {
        "ID": {
          "description": "Identificador único do aluno",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Nome": {
          "description": "Nome completo do aluno",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        }
      },
      "required": [
        "ID",
        "Nome"
      ],
      "type": "object"
    },
    "TDadosIesEmissora": {
      "description": "Dados da instituição de ensino superior emissora",
      "properties": {
        "CNPJ": {
          "description": "Número do CNPJ sem separadores",
          "pattern": "^[0-9]{14}$",
          "type": "string"
        },
        "CodigoMEC": {
          "description": "Código de identificação da instituição no MEC",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "Credenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "Endereco": {
          "$ref": "#/definitions/TEndereco"
        },
        "Mantenedora": {
          "properties": {
            "CNPJ": {
              "$ref": "#/definitions/TCNPJ"
            },
            "Endereco": {
              "$ref": "#/definitions/TEndereco"
            },
            "RazaoSocial": {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "Nome": {
          "description": "Nome completo da instituição",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Recredenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "RenovacaoDeRecredenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        }
      },
      "required": [
        "Nome",
        "CodigoMEC",
        "CNPJ",
        "Endereco",
        "Credenciamento"
      ],
      "type": "object"
    },
    "TDadosMinimoCurso": {
      "description": "Dados do curso",
      "oneOf": [
        {
          "properties": {
            "CodigoCursoEMEC": {
              "description": "Código e-MEC do curso",
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          },
          "required": [
            "CodigoCursoEMEC"
          ]
        },
        {
          "properties": {
            "SemCodigoCursoEMEC": {
              "description": "Informações sobre a tramitação do processo e-MEC",
              "properties": {
                "DataCadastro": {
                  "description": "Data de cadastro do processo e-MEC",
                  "format": "date",
                  "type": "string"
                },
                "DataProtocolo": {
                  "description": "Data de protocolo do processo e-MEC",
                  "format": "date",
                  "type": "string"
                },
                "NumeroProcesso": {
                  "description": "Número do processo e-MEC",
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                },
                "TipoProcesso": {
                  "description": "Tipo do processo e-MEC",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                  "type": "string"
                }
              },
              "required": [
                "NumeroProcesso",
                "TipoProcesso",
                "DataCadastro",
                "DataProtocolo"
              ],
              "type": "object"
            }
          },
          "required": [
            "SemCodigoCursoEMEC"
          ]
        }
      ],
      "properties": {
        "Autorizacao": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "Habilitacao": {
          "$ref": "#/definitions/THabilitacao"
        },
        "NomeCurso": {
          "description": "Nome completo do curso",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Reconhecimento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "RenovacaoReconhecimento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        }
      },
      "required": [
        "NomeCurso",
        "Autorizacao",
        "Reconhecimento"
      ],
      "type": "object"
    },
    "TDadosMinimoCursoNSF": {
      "description": "Dados do curso NSF",
      "oneOf": [
        {
          "properties": {
            "CodigoCursoEMEC": {
              "description": "Código e-MEC do curso",
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          },
          "required": [
            "CodigoCursoEMEC"
          ]
        },
        {
          "properties": {
            "SemCodigoCursoEMEC": {
              "description": "Informações sobre a tramitação do processo e-MEC",
              "properties": {
                "DataCadastro": {
                  "description": "Data de cadastro do processo e-MEC",
                  "format": "date",
                  "type": "string"
                },
                "DataProtocolo": {
                  "description": "Data de protocolo do processo e-MEC",
                  "format": "date",
                  "type": "string"
                },
                "NumeroProcesso": {
                  "description": "Número do processo e-MEC",
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                },
                "TipoProcesso": {
                  "description": "Tipo do processo e-MEC",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                  "type": "string"
                }
              },
              "required": [
                "NumeroProcesso",
                "TipoProcesso",
                "DataCadastro",
                "DataProtocolo"
              ],
              "type": "object"
            }
          },
          "required": [
            "SemCodigoCursoEMEC"
          ]
        }
      ],
      "properties": {
        "Autorizacao": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "Habilitacao": {
          "$ref": "#/definitions/THabilitacao"
        },
        "NomeCurso": {
          "description": "Nome completo do curso",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Reconhecimento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "RenovacaoReconhecimento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        }
      },
      "required": [
        "NomeCurso"
      ],
      "type": "object"
    },
    "TEndereco": {
      "allOf": [
        {
          "$ref": "#/definitions/TMunicipio"
        }
      ],
      "description": "Dados de localização",
      "properties": {
        "Bairro": {
          "description": "Região do município",
          "maxLength": 60,
          "minLength": 2,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "CEP": {
          "description": "Código Postal",
          "pattern": "^[0-9]{8}$",
          "type": "string"
        },
        "Complemento": {
          "description": "Identificação da unidade",
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Logradouro": {
          "description": "Nome do local",
          "maxLength": 150,
          "minLength": 2,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Numero": {
          "description": "Número da casa ou edifício",
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        }
      },
      "required": [
        "Logradouro",
        "Bairro",
        "CEP"
      ],
      "type": "object"
    },
    "THabilitacao": {
      "description": "Habilitação do curso",
      "items": {
        "properties": {
          "DataHabilitacao": {
            "format": "date"
          },
          "NomeHabilitacao": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
            "type": "string"
          }
        },
        "required": [
          "NomeHabilitacao",
          "DataHabilitacao"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "TMunicipio": {
      "description": "Dados do município",
      "properties": {
        "CodigoMunicipio": {
          "description": "Código do município da tabela do IBGE",
          "pattern": "^[0-9]{7}$",
          "type": "string"
        },
        "NomeMunicipio": {
          "description": "Nome completo do município",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "UF": {
          "$ref": "#/definitions/TUF"
        }
      },
      "required": [
        "CodigoMunicipio",
        "NomeMunicipio",
        "UF"
      ],
      "type": "object"
    },
    "TPolo": {
      "allOf": [
        {
          "properties": {
            "Endereco": {
              "$ref": "#/definitions/TEndereco"
            }
          },
          "required": [
            "Endereco"
          ]
        }
      ],
      "description": "Dados do polo de educação à distância",
      "properties": {
        "CodigoEMEC": {
          "description": "Código e-MEC do polo",
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "Nome": {
          "description": "Nome completo do polo",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        }
      },
      "required": [
        "Nome",
        "CodigoEMEC"
      ],
      "type": "object"
    },
    "TUF": {
      "description": "Sigla da unidade federativa",
      "enum": [
        "AC",
        "AL",
        "AM",
        "AP",
        "BA",
        "CE",
        "DF",
        "ES",
        "GO",
        "MA",
        "MG",
        "MS",
        "MT",
        "PA",
        "PB",
        "PE",
        "PI",
        "PR",
        "RJ",
        "RN",
        "RO",
        "RR",
        "RS",
        "SC",
        "SE",
        "SP",
        "TO"
      ],
      "type": "string"
    },
    "TinfHistoricoEscolar": {
      "description": "Informações do histórico escolar",
      "oneOf": [
        {
          "required": [
            "DadosCurso"
          ]
        },
        {
          "required": [
            "DadosCursoNSF"
          ]
        }
      ],
      "properties": {
        "Aluno": {
          "$ref": "#/definitions/TDadosDiplomado"
        },
        "DadosCurso": {
          "$ref": "#/definitions/TDadosMinimoCurso"
        },
        "DadosCursoNSF": {
          "$ref": "#/definitions/TDadosMinimoCursoNSF"
        },
        "IesEmissora": {
          "$ref": "#/definitions/TDadosIesEmissora"
        },
        "InformacoesAdicionais": {
          "maxLength": 5000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "Aluno",
        "IesEmissora"
      ],
      "type": "object"
    }
  },
  "description": "Esquema JSON para Validação de Históricos Acadêmicos Integrais, Versão 1.05",
  "properties": {
    "data": {
      "description": "Dados do histórico acadêmico integral",
      "oneOf": [
        {
          "properties": {
            "infHistoricoEscolar": {
              "$ref": "#/definitions/TinfHistoricoEscolar"
            }
          },
          "required": [
            "infHistoricoEscolar"
          ]
        },
        {
          "properties": {
            "infHistoricoEscolarSegundaViaNatoFisico": {
              "$ref": "#/definitions/TinfHistoricoEscolar"
            }
          },
          "required": [
            "infHistoricoEscolarSegundaViaNatoFisico"
          ]
        }
      ],
      "properties": {
        "Versao": {
          "const": "1.05",
          "description": "Versão do leiaute do histórico acadêmico integral",
          "type": "string"
        },
        "ambiente": {
          "description": "Tipo do ambiente em que o histórico acadêmico integral foi emitido",
          "enum": [
            "Produção",
            "Homologação"
          ],
          "type": "string"
        }
      },
      "required": [
        "Versao"
      ],
      "type": "object"
    },
    "meta": {
      "description": "Metadados do histórico acadêmico integral",
      "properties": {
        "clientId": {
          "description": "Identificador único universal do cliente do RAP",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-4[0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$",
          "type": "string"
        },
        "clientSignature": {
          "$comment": "Atributo ainda não tem funcionalidade, será usado em versões futuras",
          "description": "Assinatura do cliente do RAP",
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "dltId": {
          "const": "ethereum",
          "description": "Nome da DLT em que o documento assinado será registrado",
          "type": "string"
        },
        "docType": {
          "const": "final_academic_transcript",
          "description": "Identificador do tipo Histórico Acadêmico Integral no RAP",
          "type": "string"
        },
        "groupId": {
          "description": "Identificador único do grupo de documentos ao qual o documento faz parte",
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "isDocSigned": {
          "description": "Flag para indicar se o documento a ser registrado conterá assinaturas",
          "enum": [
            "true",
            "false"
          ],
          "type": "string"
        },
        "mimeType": {
          "description": "Tipo da mídia do histórico acadêmico integral",
          "enum": [
            "application/xml",
            "text/xml"
          ],
          "type": "string"
        },
        "yourNumber": {
          "description": "Identificador único gerado pelo cliente do RAP",
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "clientId",
        "clientSignature",
        "docType",
        "groupId",
        "mimeType",
        "yourNumber"
      ],
      "type": "object"
    }
  },
  "required": [
    "meta",
    "data"
  ],
  "title": "Esquema JSON de Histórico Acadêmico Integral (Final)",
  "type": "object"
}
