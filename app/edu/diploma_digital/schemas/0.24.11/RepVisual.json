{
  "$id": "http://diploma-digital.com/RepresentacaoVisualDiplomaDigital.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TRepresentacaoVisualDiplomaDigital": {
      "additionalProperties": true,
      "else": {
        "not": {
          "required": [
            "meta"
          ]
        },
        "required": [
          "data"
        ]
      },
      "if": {
        "properties": {
          "op": {
            "const": "insert"
          }
        }
      },
      "properties": {
        "data": {
          "additionalProperties": true,
          "description": "Dados da representação visual do diploma digital",
          "properties": {
            "ReferenciaDiploma": {
              "description": "Código de validação do diploma digital",
              "maxLength": 255,
              "pattern": "^[0-9]{1,}\\.[0-9]{1,}\\.[a-f0-9]{12,}$",
              "type": "string"
            }
          },
          "required": [
            "ReferenciaDiploma"
          ],
          "type": "object"
        },
        "meta": {
          "additionalProperties": true,
          "description": "Metadados de registro do documento",
          "properties": {
            "attachment": {
              "description": "Nome do arquivo PDF/A da representação visual",
              "pattern": "^.*\\.pdf$",
              "type": "string"
            },
            "clientId": {
              "description": "Código de identificação do cliente no formato UUIDV4",
              "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-4[0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$",
              "type": "string"
            },
            "clientSignature": {
              "description": "String com tamanho mínimo 1 e máximo 255",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            },
            "dltId": {
              "const": "ethereum",
              "description": "DLT de registro do diploma digital",
              "type": "string"
            },
            "docType": {
              "const": "visual_rep_degree",
              "description": "Identificação do tipo do documento",
              "type": "string"
            },
            "groupId": {
              "description": "String com tamanho mínimo 1 e máximo 255",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            },
            "isDocSigned": {
              "description": "Booleano representado por true/false",
              "enum": [
                "true",
                "false"
              ],
              "type": "string"
            },
            "mimeType": {
              "const": "application/pdf",
              "description": "Tipo do arquivo do documento",
              "type": "string"
            },
            "yourNumber": {
              "description": "String com tamanho mínimo 1 e máximo 255",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            }
          },
          "required": [
            "clientId",
            "clientSignature",
            "groupId",
            "yourNumber",
            "docType",
            "mimeType"
          ],
          "type": "object"
        },
        "op": {
          "default": "insert",
          "enum": [
            "insert",
            "update"
          ],
          "type": "string"
        }
      },
      "then": {
        "required": [
          "meta",
          "data"
        ]
      },
      "type": "object"
    }
  },
  "description": "Esquema JSON para Validação de Representações Visuais de Diplomas Digitais, Versão 1.05",
  "oneOf": [
    {
      "$ref": "#/definitions/TRepresentacaoVisualDiplomaDigital"
    },
    {
      "items": {
        "$ref": "#/definitions/TRepresentacaoVisualDiplomaDigital"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  ],
  "title": "Esquema JSON da Representação Visual do Diploma Digital"
}
