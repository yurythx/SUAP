{
  "$id": "http://example.com/ListaDiplomasRevogados.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TAtoRegulatorio": {
      "description": "Ato regulatório de reconhecimento",
      "properties": {
        "Data": {
          "description": "Data do ato regulatório",
          "format": "date"
        },
        "DataPublicacao": {
          "description": "Data de publicação do ato regulatório",
          "format": "date"
        },
        "Numero": {
          "description": "Número do ato regulatório",
          "pattern": "^(S/N)|(([0-9])[-0-9a-zA-Z0-9_/]*)$",
          "type": "string"
        },
        "NumeroDOU": {
          "description": "Número do ato regulatório no diário oficial da união",
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "PaginaPublicacao": {
          "description": "Página de publicação do ato regulatório",
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "SecaoPublicacao": {
          "description": "Seção de publicação do ato regulatório",
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "Tipo": {
          "description": "Tipo do ato regulatório",
          "enum": [
            "Parecer",
            "Resolução",
            "Decreto",
            "Portaria",
            "Deliberação",
            "Lei Federal",
            "Lei Estadual",
            "Lei Municipal"
          ],
          "type": "string"
        },
        "VeiculoPublicacao": {
          "description": "Veículo de publicação do ato regulatório",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        }
      },
      "required": [
        "Tipo",
        "Numero",
        "Data"
      ],
      "type": "object"
    },
    "TAtoRegulatorioComOuSemEMEC": {
      "description": "Ato regulatório de reconhecimento",
      "oneOf": [
        {
          "properties": {
            "Data": {
              "description": "Data do ato regulatório",
              "format": "date"
            },
            "DataPublicacao": {
              "description": "Data de publicação do ato regulatório",
              "format": "date"
            },
            "Numero": {
              "description": "Número do ato regulatório",
              "pattern": "^(S/N)|(([0-9])[-0-9a-zA-Z0-9_/]*)$",
              "type": "string"
            },
            "NumeroDOU": {
              "description": "Número do ato regulatório no diário oficial da união",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "PaginaPublicacao": {
              "description": "Página de publicação do ato regulatório",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "SecaoPublicacao": {
              "description": "Seção de publicação do ato regulatório",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "Tipo": {
              "description": "Tipo do ato regulatório",
              "enum": [
                "Parecer",
                "Resolução",
                "Decreto",
                "Portaria",
                "Deliberação",
                "Lei Federal",
                "Lei Estadual",
                "Lei Municipal",
                "Ato Próprio"
              ],
              "type": "string"
            },
            "VeiculoPublicacao": {
              "description": "Veículo de publicação do ato regulatório",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            }
          },
          "required": [
            "Tipo",
            "Numero",
            "Data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "InformacoesTramitacaoEMEC": {
              "description": "Informações sobre a tramitação do processo e-MEC",
              "properties": {
                "DataCadastro": {
                  "description": "Data de abertura do processo e-MEC",
                  "format": "date"
                },
                "DataProtocolo": {
                  "description": "Data de emissão do protocolo e-MEC",
                  "format": "date"
                },
                "NumeroProcesso": {
                  "description": "Número do processo e-MEC",
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                },
                "TipoProcesso": {
                  "description": "Tipo do processo e-MEC",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                  "type": "string"
                }
              },
              "required": [
                "NumeroProcesso",
                "TipoProcesso",
                "DataCadastro",
                "DataProtocolo"
              ],
              "type": "object"
            }
          },
          "required": [
            "InformacoesTramitacaoEMEC"
          ],
          "type": "object"
        }
      ]
    },
    "TCNPJ": {
      "description": "Número do CNPJ sem separadores",
      "pattern": "^[0-9]{14}$",
      "type": "string"
    },
    "TDadosIesRegistradora": {
      "description": "Dados da instituição de ensino superior registradora",
      "properties": {
        "AtoRegulatorioAutorizacaoRegistro": {
          "$ref": "#/definitions/TAtoRegulatorio"
        },
        "CNPJ": {
          "$ref": "#/definitions/TCNPJ"
        },
        "CodigoMEC": {
          "description": "Código de identificação da instituição no MEC",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "Credenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "Endereco": {
          "$ref": "#/definitions/TEndereco"
        },
        "Mantenedora": {
          "description": "Dados da mantenedora da instituição",
          "properties": {
            "CNPJ": {
              "$ref": "#/definitions/TCNPJ"
            },
            "Endereco": {
              "$ref": "#/definitions/TEndereco"
            },
            "RazaoSocial": {
              "description": "Nome registrado da pessoa jurídica",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            }
          },
          "required": [
            "RazaoSocial",
            "CNPJ",
            "Endereco"
          ],
          "type": "object"
        },
        "Nome": {
          "description": "Nome completo da instituição",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Recredenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "RenovacaoDeRecredenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        }
      },
      "required": [
        "Nome",
        "CodigoMEC",
        "CNPJ",
        "Endereco",
        "Credenciamento",
        "Mantenedora"
      ],
      "type": "object"
    },
    "TEndereco": {
      "allOf": [
        {
          "$ref": "#/definitions/TMunicipio"
        }
      ],
      "description": "Dados de localização",
      "properties": {
        "Bairro": {
          "description": "Região do município",
          "maxLength": 60,
          "minLength": 2,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "CEP": {
          "description": "Código Postal",
          "pattern": "^[0-9]{8}$",
          "type": "string"
        },
        "Complemento": {
          "description": "Identificação da unidade",
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Logradouro": {
          "description": "Nome do local",
          "maxLength": 60,
          "minLength": 2,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Numero": {
          "description": "Número da casa ou edifício",
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        }
      },
      "required": [
        "Logradouro",
        "Bairro",
        "CEP"
      ],
      "type": "object"
    },
    "TMunicipio": {
      "description": "Dados do município",
      "properties": {
        "CodigoMunicipio": {
          "description": "Código do município da tabela do IBGE",
          "pattern": "^[0-9]{7}$",
          "type": "string"
        },
        "NomeMunicipio": {
          "description": "Nome completo do município",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "UF": {
          "$ref": "#/definitions/TUF"
        }
      },
      "required": [
        "CodigoMunicipio",
        "NomeMunicipio",
        "UF"
      ],
      "type": "object"
    },
    "TUF": {
      "description": "Sigla da unidade federativa",
      "enum": [
        "AC",
        "AL",
        "AM",
        "AP",
        "BA",
        "CE",
        "DF",
        "ES",
        "GO",
        "MA",
        "MG",
        "MS",
        "MT",
        "PA",
        "PB",
        "PE",
        "PI",
        "PR",
        "RJ",
        "RN",
        "RO",
        "RR",
        "RS",
        "SC",
        "SE",
        "SP",
        "TO"
      ],
      "type": "string"
    }
  },
  "description": "Esquema JSON para Validação de Lista de Diplomas Revogados, Versão 1.04.1",
  "properties": {
    "data": {
      "description": "Dados da lista de diplomas revogados",
      "properties": {
        "Versao": {
          "const": "1.04.1",
          "description": "Versão do leiaute da lista de diplomas revogados",
          "type": "string"
        },
        "ambiente": {
          "description": "Tipo do ambiente em que a lista de diplomas revogados foi emitida",
          "enum": [
            "Produção",
            "Homologação"
          ],
          "type": "string"
        },
        "infListaDiplomasAnulados": {
          "description": "Informações da lista de diplomas revogados",
          "properties": {
            "DataMaximaProximaAtualizacao": {
              "description": "Data máxima de validade da lista de diplomas",
              "format": "date",
              "type": "string"
            },
            "DiplomasAnulados": {
              "description": "Lista de diplomas anulados",
              "items": {
                "properties": {
                  "DiplomaAnulado": {
                    "description": "Informações de anulação referentes a um diploma",
                    "oneOf": [
                      {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "CodigoDiplomaAnulado"
                              ]
                            },
                            {
                              "required": [
                                "DataAnulacao"
                              ]
                            },
                            {
                              "required": [
                                "MotivoAnulacao"
                              ]
                            },
                            {
                              "required": [
                                "AnotacaoAnulacao"
                              ]
                            }
                          ]
                        },
                        "properties": {
                          "IdDiplomaAnulado": {
                            "description": "Número identificador do diploma",
                            "pattern": "^[1-9][0-9]*$",
                            "type": "string"
                          }
                        },
                        "required": [
                          "IdDiplomaAnulado"
                        ]
                      },
                      {
                        "not": {
                          "required": [
                            "IdDiplomaAnulado"
                          ]
                        },
                        "properties": {
                          "AnotacaoAnulacao": {
                            "description": "Informações adicionais da anulação",
                            "maxLength": 255,
                            "minLength": 1,
                            "type": "string"
                          },
                          "CodigoDiplomaAnulado": {
                            "description": "Código de segurança do diploma",
                            "pattern": "^[0-9]{1,}\\.[0-9]{1,}\\.[a-f0-9]{12,}$",
                            "type": "string"
                          },
                          "DataAnulacao": {
                            "description": "Data da anulação do diploma",
                            "format": "date",
                            "type": "string"
                          },
                          "MotivoAnulacao": {
                            "description": "Motivo da anulação do diploma",
                            "enum": [
                              "Erro de Fato",
                              "Erro de Direito",
                              "Decisão Judicial",
                              "Reemissão para Complemento de Informação",
                              "Reemissão para Inclusão de Habilitação",
                              "Reemissão para Anotaçao de Registro"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "CodigoDiplomaAnulado",
                          "DataAnulacao",
                          "MotivoAnulacao"
                        ]
                      }
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "DiplomaAnulado"
                ],
                "type": "object"
              },
              "minItems": 0,
              "type": "array"
            },
            "IesRegistradora": {
              "$ref": "#/definitions/TDadosIesRegistradora"
            },
            "NumeroDeSequencia": {
              "description": "Versão do arquivo da lista de diplomas anulados",
              "pattern": "^0|[1-9][0-9]*$",
              "type": "string"
            }
          },
          "required": [
            "NumeroDeSequencia",
            "IesRegistradora",
            "DiplomasAnulados",
            "DataMaximaProximaAtualizacao"
          ],
          "type": "object"
        }
      },
      "required": [
        "Versao",
        "infListaDiplomasAnulados"
      ],
      "type": "object"
    },
    "meta": {
      "description": "Metadados da lista de diplomas revogados",
      "properties": {
        "clientId": {
          "description": "Identificador único universal do cliente do RAP",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-4[0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$",
          "type": "string"
        },
        "clientSignature": {
          "$comment": "Atributo ainda não tem funcionalidade, será usado em versões futuras",
          "description": "Assinatura do cliente do RAP",
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "dltId": {
          "const": "ethereum",
          "description": "Nome da DLT em que o documento assinado será registrado",
          "type": "string"
        },
        "docType": {
          "const": "degree_revocation_list",
          "description": "Identificador do tipo Lista de Diploma Revogados no RAP",
          "type": "string"
        },
        "groupId": {
          "description": "Identificador único do grupo de documentos ao qual o documento faz parte",
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "isDocSigned": {
          "description": "Flag para indicar se o documento a ser registrado conterá assinaturas",
          "enum": [
            "true",
            "false"
          ],
          "type": "string"
        },
        "mimeType": {
          "description": "Tipo da mídia da lista de diplomas revogados",
          "enum": [
            "application/xml",
            "text/xml"
          ],
          "type": "string"
        },
        "yourNumber": {
          "description": "Identificador único gerado pelo cliente do RAP",
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "clientId",
        "clientSignature",
        "docType",
        "groupId",
        "mimeType",
        "yourNumber"
      ],
      "type": "object"
    }
  },
  "required": [
    "meta",
    "data"
  ],
  "title": "Esquema JSON de Lista de Diplomas Revogados",
  "type": "object"
}
