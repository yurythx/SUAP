{
  "$id": "http://example.com/HistoricoEscolarParcial.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TCNPJ": {
      "description": "Número do CNPJ sem separadores",
      "pattern": "^[0-9]{14}$",
      "type": "string"
    },
    "TCargaHoraria": {
      "oneOf": [
        {
          "properties": {
            "HoraAula": {
              "description": "Carga horária em numéros inteiros",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            }
          },
          "required": [
            "HoraAula"
          ]
        },
        {
          "properties": {
            "HoraRelogio": {
              "description": "Carga horária em números decimais",
              "pattern": "^[0-9]+\\.[0-9]{2}$",
              "type": "string"
            }
          },
          "required": [
            "HoraRelogio"
          ]
        }
      ]
    },
    "TDadosAluno": {
      "description": "Dados pessoais do aluno",
      "oneOf": [
        {
          "properties": {
            "RG": {
              "$ref": "#/definitions/TRG"
            }
          },
          "required": [
            "RG"
          ]
        },
        {
          "properties": {
            "OutroDocumentoIdentificacao": {
              "$ref": "#/definitions/TOutroDocumentoIdentificacao"
            }
          },
          "required": [
            "OutroDocumentoIdentificacao"
          ]
        }
      ],
      "properties": {
        "CPF": {
          "description": "Número do CPF do aluno sem separadores",
          "pattern": "^[0-9]{11}$",
          "type": "string"
        },
        "DataNascimento": {
          "description": "Data de nascimento do aluno",
          "format": "date"
        },
        "ID": {
          "description": "Identificador único do aluno",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Nacionalidade": {
          "description": "Nacionalidade de aluno",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Naturalidade": {
          "description": "Naturalidade do aluno",
          "oneOf": [
            {
              "$ref": "#/definitions/TMunicipio"
            },
            {
              "$ref": "#/definitions/TMunicipioEstrangeiro"
            }
          ],
          "type": "object"
        },
        "Nome": {
          "description": "Nome completo do aluno",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "NomeSocial": {
          "description": "Nome social do aluno",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Sexo": {
          "description": "Sexo biológico do aluno",
          "enum": [
            "F",
            "M"
          ],
          "type": "string"
        }
      },
      "required": [
        "ID",
        "Nome",
        "Sexo",
        "Nacionalidade",
        "Naturalidade",
        "CPF",
        "DataNascimento"
      ],
      "type": "object"
    },
    "TDadosMinimoCurso": {
      "description": "Dados do curso",
      "oneOf": [
        {
          "properties": {
            "CodigoCursoEMEC": {
              "description": "Código e-MEC do curso",
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          },
          "required": [
            "CodigoCursoEMEC"
          ]
        },
        {
          "properties": {
            "SemCodigoCursoEMEC": {
              "description": "Informações sobre a tramitação do processo e-MEC",
              "properties": {
                "NumeroProcesso": {
                  "description": "Número do processo e-MEC",
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                }
              },
              "required": [
                "NumeroProcesso"
              ],
              "type": "object"
            }
          },
          "required": [
            "SemCodigoCursoEMEC"
          ]
        }
      ],
      "properties": {
        "NomeCurso": {
          "description": "Nome completo do curso",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        }
      },
      "required": [
        "NomeCurso"
      ],
      "type": "object"
    },
    "TDadosMinimoIesEmissora": {
      "description": "Dados da instituição de ensino superior emissora",
      "properties": {
        "CNPJ": {
          "description": "Número do CNPJ sem separadores",
          "pattern": "^[0-9]{14}$",
          "type": "string"
        },
        "CodigoMEC": {
          "description": "Código de identificação da instituição no MEC",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "Nome": {
          "description": "Nome completo da instituição",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        }
      },
      "required": [
        "Nome",
        "CodigoMEC",
        "CNPJ"
      ],
      "type": "object"
    },
    "TDocentes": {
      "description": "Relação de Docentes",
      "items": {
        "properties": {
          "Docente": {
            "decription": "Docente responsável pela entrada no histórico",
            "properties": {
              "CPF": {
                "description": "Número do CPF do docente sem separadores",
                "pattern": "^[0-9]{11}$",
                "type": "string"
              },
              "Lattes": {
                "description": "Link para o currículo Lattes do docente",
                "maxLength": 255,
                "minLength": 1,
                "pattern": "^http://lattes\\.cnpq\\.br/[0-9]+$",
                "type": "string"
              },
              "Nome": {
                "description": "Nome completo do docente",
                "maxLength": 255,
                "minLength": 1,
                "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                "type": "string"
              },
              "Titulacao": {
                "description": "Titulação do docente",
                "enum": [
                  "Graduação",
                  "Especialização",
                  "Mestrado",
                  "Doutorado",
                  "Tecnólogo"
                ],
                "type": "string"
              }
            },
            "required": [
              "Nome",
              "Titulacao"
            ],
            "type": "object"
          }
        },
        "required": [
          "Docente"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "TEnadeNaoHabilitado": {
      "description": "Informações sobre estudante não habilitado para o ENADE",
      "oneOf": [
        {
          "properties": {
            "Motivo": {
              "enum": [
                "Estudante não habilitado ao Enade em razão do calendário do ciclo avaliativo",
                "Estudante não habilitado ao Enade em razão da natureza do projeto pedagógico do curso"
              ],
              "type": "string"
            }
          },
          "required": [
            "Motivo"
          ]
        },
        {
          "properties": {
            "OutroMotivo": {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            }
          },
          "required": [
            "OutroMotivo"
          ]
        }
      ],
      "properties": {
        "Condicao": {
          "enum": [
            "Ingressante",
            "Concluinte"
          ],
          "type": "string"
        },
        "Edicao": {
          "pattern": "^[0-9]{4}$",
          "type": "string"
        }
      },
      "required": [
        "Condicao",
        "Edicao"
      ],
      "type": "object"
    },
    "THistoricoEscolar": {
      "description": "Histórico acadêmico do aluno",
      "properties": {
        "CargaHorariaCurso": {
          "$ref": "#/definitions/TCargaHoraria"
        },
        "CargaHorariaCursoIntegralizada": {
          "$ref": "#/definitions/TCargaHoraria"
        },
        "DataEmissaoHistorico": {
          "description": "Data de emissão do histórico escolar",
          "format": "date"
        },
        "ENADE": {
          "description": "Informações sobre a participação do aluno no ENADE",
          "items": {
            "oneOf": [
              {
                "properties": {
                  "SituacaoENADE": {
                    "properties": {
                      "Habilitado": {
                        "$ref": "#/definitions/TInformacoesEnade"
                      }
                    },
                    "required": [
                      "Habilitado"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "SituacaoENADE"
                ]
              },
              {
                "properties": {
                  "SituacaoENADE": {
                    "properties": {
                      "NaoHabilitado": {
                        "$ref": "#/definitions/TEnadeNaoHabilitado"
                      }
                    },
                    "required": [
                      "NaoHabilitado"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "SituacaoENADE"
                ]
              },
              {
                "properties": {
                  "SituacaoENADE": {
                    "properties": {
                      "Irregular": {
                        "$ref": "#/definitions/TInformacoesEnade"
                      }
                    },
                    "required": [
                      "Irregular"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "SituacaoENADE"
                ]
              }
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "ElementosHistorico": {
          "description": "Elementos que compõem o histórico escolar",
          "items": {
            "oneOf": [
              {
                "properties": {
                  "Disciplina": {
                    "description": "Disciplina cursada pelo aluno",
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "Nota",
                            "NotaAteCem"
                          ]
                        },
                        {
                          "required": [
                            "Nota",
                            "Conceito"
                          ]
                        },
                        {
                          "required": [
                            "Nota",
                            "ConceitoRM"
                          ]
                        },
                        {
                          "required": [
                            "Nota",
                            "ConceitoEspecificoDoCurso"
                          ]
                        },
                        {
                          "required": [
                            "NotaAteCem",
                            "Conceito"
                          ]
                        },
                        {
                          "required": [
                            "NotaAteCem",
                            "ConceitoRM"
                          ]
                        },
                        {
                          "required": [
                            "NotaAteCem",
                            "ConceitoEspecificoDoCurso"
                          ]
                        },
                        {
                          "required": [
                            "Conceito",
                            "ConceitoRM"
                          ]
                        },
                        {
                          "required": [
                            "Conceito",
                            "ConceitoEspecificoDoCurso"
                          ]
                        },
                        {
                          "required": [
                            "ConceitoRM",
                            "ConceitoEspecificoDoCurso"
                          ]
                        }
                      ]
                    },
                    "properties": {
                      "CargaHoraria": {
                        "$ref": "#/definitions/TCargaHoraria"
                      },
                      "CodigoDisciplina": {
                        "description": "Código da disciplina na instituição",
                        "maxLength": 255,
                        "minLength": 1,
                        "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                        "type": "string"
                      },
                      "Conceito": {
                        "description": "Conceito do aluno na disciplina",
                        "enum": [
                          "A+",
                          "A",
                          "A-",
                          "B+",
                          "B",
                          "B-",
                          "C+",
                          "C",
                          "C-",
                          "D+",
                          "D",
                          "D-",
                          "E+",
                          "E",
                          "E-",
                          "F+",
                          "F",
                          "F-"
                        ],
                        "type": "string"
                      },
                      "ConceitoEspecificoDoCurso": {
                        "description": "Conceito especifico usado pelo curso do aluno na disciplina",
                        "maxLength": 255,
                        "minLength": 1,
                        "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                        "type": "string"
                      },
                      "ConceitoRM": {
                        "description": "Conceito RM do aluno na disciplina",
                        "enum": [
                          "A",
                          "B",
                          "C",
                          "APD",
                          "APP",
                          "APR"
                        ],
                        "type": "string"
                      },
                      "Docentes": {
                        "$ref": "#/definitions/TDocentes"
                      },
                      "NomeDisciplina": {
                        "description": "Nome completo da disciplina",
                        "maxLength": 255,
                        "minLength": 1,
                        "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                        "type": "string"
                      },
                      "Nota": {
                        "description": "Nota até dez do aluno na disciplina",
                        "pattern": "^([0-9]\\.[0-9]{2}|10\\.00)$",
                        "type": "string"
                      },
                      "NotaAteCem": {
                        "description": "Nota até cem do aluno na disciplina",
                        "pattern": "^([0-9]\\.[0-9]{2}|[1-9][0-9]\\.[0-9]{2}|100\\.00)$",
                        "type": "string"
                      },
                      "PeriodoLetivo": {
                        "description": "Período em que a disciplina foi cursada",
                        "maxLength": 255,
                        "minLength": 1,
                        "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                        "type": "string"
                      },
                      "Situacao": {
                        "anyOf": [
                          {
                            "enum": [
                              "Aprovado",
                              "Pendente",
                              "Reprovado"
                            ],
                            "type": "string"
                          },
                          {
                            "properties": {
                              "Aprovado": {
                                "oneOf": [
                                  {
                                    "properties": {
                                      "FormaIntegralizacao": {
                                        "description": "Forma de integralização desta entrada no histórico",
                                        "enum": [
                                          "Cursado",
                                          "Validado",
                                          "Aproveitado"
                                        ],
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "FormaIntegralizacao"
                                    ]
                                  },
                                  {
                                    "properties": {
                                      "OutraFormaIntegralizacao": {
                                        "description": "Outra forma de integralização desta entrada no histórico",
                                        "maxLength": 255,
                                        "minLength": 1,
                                        "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "OutraFormaIntegralizacao"
                                    ]
                                  }
                                ],
                                "type": "object"
                              }
                            },
                            "required": [
                              "Aprovado"
                            ],
                            "type": "object"
                          }
                        ],
                        "description": "Situação do aluno na disciplina"
                      }
                    },
                    "required": [
                      "NomeDisciplina",
                      "PeriodoLetivo",
                      "CargaHoraria",
                      "Situacao",
                      "Docentes"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "Disciplina"
                ]
              },
              {
                "properties": {
                  "AtividadeComplementar": {
                    "description": "Atividade complementar realizada pelo aluno",
                    "properties": {
                      "CargaHorariaEmHoraRelogio": {
                        "description": "Carga horária em números decimais",
                        "pattern": "^[0-9]+\\.[0-9]{2}$",
                        "type": "string"
                      },
                      "DataFim": {
                        "description": "Data de fim da atividade complementar",
                        "format": "date"
                      },
                      "DataInicio": {
                        "description": "Data de inicio da atividade complementar",
                        "format": "date"
                      },
                      "DataRegistro": {
                        "description": "Data de registro da atividade complementar",
                        "format": "date"
                      },
                      "Descricao": {
                        "description": "Descrição da atividade complementar",
                        "maxLength": 255,
                        "minLength": 1,
                        "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                        "type": "string"
                      },
                      "DocentesResponsaveisPelaValidacao": {
                        "$ref": "#/definitions/TDocentes"
                      },
                      "TipoAtividadeComplementar": {
                        "description": "Tipo da atividade complementar",
                        "maxLength": 255,
                        "minLength": 1,
                        "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "DataInicio",
                      "DataFim",
                      "TipoAtividadeComplementar",
                      "CargaHorariaEmHoraRelogio",
                      "DocentesResponsaveisPelaValidacao"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "AtividadeComplementar"
                ]
              },
              {
                "properties": {
                  "Estagio": {
                    "description": "Estágio realizado pelo aluno",
                    "properties": {
                      "CargaHorariaEmHorasRelogio": {
                        "description": "Carga horária em números decimais",
                        "pattern": "^[0-9]+\\.[0-9]{2}$",
                        "type": "string"
                      },
                      "Concedente": {
                        "description": "Informações sobre concedente onde foi realizado estágio",
                        "properties": {
                          "CNPJ": {
                            "$ref": "#/definitions/TCNPJ"
                          },
                          "NomeFantasia": {
                            "description": "Nome fantasia do concedente do estágio",
                            "maxLength": 255,
                            "minLength": 1,
                            "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                            "type": "string"
                          },
                          "RazaoSocial": {
                            "description": "Razão social do concedente do estágio",
                            "maxLength": 255,
                            "minLength": 1,
                            "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                            "type": "string"
                          }
                        },
                        "required": [
                          "RazaoSocial",
                          "CNPJ"
                        ],
                        "type": "object"
                      },
                      "DataFim": {
                        "description": "Data de fim do estágio",
                        "format": "date"
                      },
                      "DataInicio": {
                        "description": "Data de inicio do estágio",
                        "format": "date"
                      },
                      "Descricao": {
                        "description": "Descrição do estágio",
                        "maxLength": 255,
                        "minLength": 1,
                        "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                        "type": "string"
                      },
                      "DocentesOrientadores": {
                        "$ref": "#/definitions/TDocentes"
                      }
                    },
                    "required": [
                      "DataInicio",
                      "DataFim",
                      "CargaHorariaEmHorasRelogio",
                      "DocentesOrientadores"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "Estagio"
                ]
              },
              {
                "properties": {
                  "SituacaoDiscente": {
                    "$ref": "#/definitions/TSituacaoDiscente"
                  }
                },
                "required": [
                  "SituacaoDiscente"
                ]
              }
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "IngressoCurso": {
          "$ref": "#/definitions/TIngressoCurso"
        },
        "SituacaoAtualDiscente": {
          "description": "Situação atual do aluno",
          "properties": {
            "PeriodoLetivo": {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            },
            "Situacao": {
              "$ref": "#/definitions/TSituacaoAtualDiscente"
            }
          },
          "required": [
            "Situacao"
          ],
          "type": "object"
        }
      },
      "required": [
        "ElementosHistorico",
        "DataEmissaoHistorico",
        "SituacaoAtualDiscente",
        "ENADE",
        "CargaHorariaCursoIntegralizada",
        "CargaHorariaCurso",
        "IngressoCurso"
      ],
      "type": "object"
    },
    "TInformacoesEnade": {
      "description": "Informações sobre condição do estudante e edição do Enade",
      "properties": {
        "Condicao": {
          "enum": [
            "Ingressante",
            "Concluinte"
          ],
          "type": "string"
        },
        "Edicao": {
          "pattern": "^[0-9]{4}$",
          "type": "string"
        }
      },
      "required": [
        "Condicao",
        "Edicao"
      ],
      "type": "object"
    },
    "TIngressoCurso": {
      "description": "Dados de ingresso do aluno no curso",
      "properties": {
        "Data": {
          "description": "Data de ingresso no curso",
          "format": "date"
        },
        "FormaAcesso": {
          "description": "Forma de acesso ao curso",
          "enum": [
            "Programas de avaliação seriada ou continuada",
            "Convenios",
            "Histórico escolar",
            "Sisu",
            "Enem",
            "Vestibular",
            "Prova agendada",
            "Entrevista",
            "Transferência",
            "Outros"
          ],
          "type": "string"
        }
      },
      "required": [
        "Data",
        "FormaAcesso"
      ],
      "type": "object"
    },
    "TMunicipio": {
      "description": "Dados do município",
      "properties": {
        "CodigoMunicipio": {
          "description": "Código do município da tabela do IBGE",
          "pattern": "^[0-9]{7}$",
          "type": "string"
        },
        "NomeMunicipio": {
          "description": "Nome completo do município",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "UF": {
          "$ref": "#/definitions/TUF"
        }
      },
      "required": [
        "CodigoMunicipio",
        "NomeMunicipio",
        "UF"
      ],
      "type": "object"
    },
    "TMunicipioEstrangeiro": {
      "description": "Dados do município estrangeiro",
      "properties": {
        "NomeMunicipioEstrangeiro": {
