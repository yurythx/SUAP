{
  "$id": "http://example.com/ArquivoFiscalizacaoEmissora.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TAtoRegulatorioComOuSemEMEC": {
      "description": "Ato regulatório de reconhecimento",
      "oneOf": [
        {
          "properties": {
            "Data": {
              "description": "Data do ato regulatório",
              "format": "date"
            },
            "DataPublicacao": {
              "description": "Data de publicação do ato regulatório",
              "format": "date"
            },
            "Numero": {
              "description": "Número do ato regulatório",
              "pattern": "^(S/N)|(([0-9])[-0-9a-zA-Z0-9_/]*)$",
              "type": "string"
            },
            "NumeroDOU": {
              "description": "Número do ato regulatório no diário oficial da união",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "PaginaPublicacao": {
              "description": "Página de publicação do ato regulatório",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "SecaoPublicacao": {
              "description": "Seção de publicação do ato regulatório",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "Tipo": {
              "description": "Tipo do ato regulatório",
              "enum": [
                "Parecer",
                "Resolução",
                "Decreto",
                "Portaria",
                "Deliberação",
                "Lei Federal",
                "Lei Estadual",
                "Lei Municipal",
                "Ato Próprio"
              ],
              "type": "string"
            },
            "VeiculoPublicacao": {
              "description": "Veículo de publicação do ato regulatório",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            }
          },
          "required": [
            "Tipo",
            "Numero",
            "Data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "InformacoesTramitacaoEMEC": {
              "description": "Informações sobre a tramitação do processo e-MEC",
              "properties": {
                "DataCadastro": {
                  "description": "Data de abertura do processo e-MEC",
                  "format": "date"
                },
                "DataProtocolo": {
                  "description": "Data de emissão do protocolo e-MEC",
                  "format": "date"
                },
                "NumeroProcesso": {
                  "description": "Número do processo e-MEC",
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                },
                "TipoProcesso": {
                  "description": "Tipo do processo e-MEC",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                  "type": "string"
                }
              },
              "required": [
                "NumeroProcesso",
                "TipoProcesso",
                "DataCadastro",
                "DataProtocolo"
              ],
              "type": "object"
            }
          },
          "required": [
            "InformacoesTramitacaoEMEC"
          ],
          "type": "object"
        }
      ]
    },
    "TCNPJ": {
      "description": "Número do CNPJ sem separadores",
      "pattern": "^[0-9]{14}$",
      "type": "string"
    },
    "TDadosIesEmissora": {
      "description": "Dados da instituição de ensino superior emissora",
      "properties": {
        "CNPJ": {
          "$ref": "#/definitions/TCNPJ"
        },
        "CodigoMEC": {
          "description": "Código de identificação da instituição no MEC",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "Credenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "Endereco": {
          "$ref": "#/definitions/TEndereco"
        },
        "Mantenedora": {
          "description": "Dados da mantenedora da instituição",
          "properties": {
            "CNPJ": {
              "$ref": "#/definitions/TCNPJ"
            },
            "Endereco": {
              "$ref": "#/definitions/TEndereco"
            },
            "RazaoSocial": {
              "description": "Nome registrado da pessoa jurídica",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            }
          },
          "required": [
            "RazaoSocial",
            "CNPJ",
            "Endereco"
          ],
          "type": "object"
        },
        "Nome": {
          "description": "Nome completo da instituição",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Recredenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "RenovacaoDeRecredenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        }
      },
      "required": [
        "Nome",
        "CodigoMEC",
        "CNPJ",
        "Endereco",
        "Credenciamento"
      ],
      "type": "object"
    },
    "TDiplomasFiscalizadosEmissora": {
      "description": "Lista de diplomas fiscalizados",
      "items": {
        "description": "Informações de referentes ao documento fiscalizado",
        "oneOf": [
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "CodigoDiploma"
                  ]
                },
                {
                  "required": [
                    "CPFDetentor"
                  ]
                },
                {
                  "required": [
                    "CodigoEMECCurso"
                  ]
                },
                {
                  "required": [
                    "DataEmissao"
                  ]
                },
                {
                  "required": [
                    "DataRegistro"
                  ]
                }
              ]
            },
            "properties": {
              "IdDocumento": {
                "description": "Número identificador do documento",
                "pattern": "^[1-9][0-9]*$",
                "type": "string"
              },
              "URLRVDD": {
                "$ref": "#/definitions/THttpsURL"
              },
              "URLXMLdeRegistroAcademico": {
                "$ref": "#/definitions/THttpsURL"
              },
              "URLXMLdoDiplomado": {
                "$ref": "#/definitions/THttpsURL"
              }
            },
            "required": [
              "IdDocumento",
              "URLXMLdoDiplomado",
              "URLRVDD"
            ]
          },
          {
            "not": {
              "required": [
                "IdDocumento"
              ]
            },
            "properties": {
              "CPFDetentor": {
                "description": "Número do CPF do diplomado sem separadores",
                "pattern": "^[0-9]{11}$",
                "type": "string"
              },
              "CodigoDiploma": {
                "description": "Código de segurança do diploma",
                "pattern": "^[0-9]{1,}\\.[0-9]{1,}\\.[a-f0-9]{12,}$",
                "type": "string"
              },
              "CodigoEMECCurso": {
                "pattern": "^[0-9]+$",
                "title": "Código de identificação do curso no MEC",
                "type": "string"
              },
              "DataEmissao": {
                "description": "Data da emissão do diploma",
                "format": "date",
                "type": "string"
              },
              "DataRegistro": {
                "description": "Data do registro do diploma",
                "format": "date",
                "type": "string"
              },
              "URLRVDD": {
                "$ref": "#/definitions/THttpsURL"
              },
              "URLXMLdeRegistroAcademico": {
                "$ref": "#/definitions/THttpsURL"
              },
              "URLXMLdoDiplomado": {
                "$ref": "#/definitions/THttpsURL"
              }
            },
            "required": [
              "CodigoDiploma",
              "CPFDetentor",
              "DataEmissao",
              "DataRegistro",
              "URLXMLdoDiplomado",
              "URLRVDD"
            ]
          }
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "TEndereco": {
      "allOf": [
        {
          "$ref": "#/definitions/TMunicipio"
        }
      ],
      "description": "Dados de localização",
      "properties": {
        "Bairro": {
          "description": "Região do município",
          "maxLength": 60,
          "minLength": 2,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "CEP": {
          "description": "Código Postal",
          "pattern": "^[0-9]{8}$",
          "type": "string"
        },
        "Complemento": {
          "description": "Identificação da unidade",
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Logradouro": {
          "description": "Nome do local",
          "maxLength": 60,
          "minLength": 2,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Numero": {
          "description": "Número da casa ou edifício",
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        }
      },
      "required": [
        "Logradouro",
        "Bairro",
        "CEP"
      ],
      "type": "object"
    },
    "THttpsURL": {
      "description": "URL",
      "maxLength": 255,
      "pattern": "^https://.*$",
      "type": "string"
    },
    "TMunicipio": {
      "description": "Dados do município",
      "properties": {
        "CodigoMunicipio": {
          "description": "Código do município da tabela do IBGE",
          "pattern": "^[0-9]{7}$",
          "type": "string"
        },
        "NomeMunicipio": {
          "description": "Nome completo do município",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "UF": {
          "$ref": "#/definitions/TUF"
        }
      },
      "required": [
        "CodigoMunicipio",
        "NomeMunicipio",
        "UF"
      ],
      "type": "object"
    },
    "TUF": {
      "description": "Sigla da unidade federativa",
      "enum": [
        "AC",
        "AL",
        "AM",
        "AP",
        "BA",
        "CE",
        "DF",
        "ES",
        "GO",
        "MA",
        "MG",
        "MS",
        "MT",
        "PA",
        "PB",
        "PE",
        "PI",
        "PR",
        "RJ",
        "RN",
        "RO",
        "RR",
        "RS",
        "SC",
        "SE",
        "SP",
        "TO"
      ],
      "type": "string"
    }
  },
  "description": "Esquema JSON para Validação do Arquivo de Fiscalização da Emissora, Versão 1.04.1",
  "properties": {
    "data": {
      "description": "Dados do Arquivo de Fiscalização da Emissora",
      "properties": {
        "Versao": {
          "const": "1.04.1",
          "description": "Versão do leiaute do Arquivo de Fiscalização da Emissora",
          "type": "string"
        },
        "ambiente": {
          "description": "Tipo do ambiente em que o Arquivo de Fiscalização da Emissora foi emitida",
          "enum": [
            "Produção",
            "Homologação"
          ],
          "type": "string"
        },
        "infArquivoFiscalizacaoEmissora": {
          "description": "Informações do Arquivo de Fiscalização da Emissora",
          "properties": {
            "DataFimFiscalizacao": {
              "description": "Data de Fim da fiscalização",
              "format": "date",
              "type": "string"
            },
            "DataInicioFiscalizacao": {
              "description": "Data de inicio da fiscalização",
              "format": "date",
              "type": "string"
            },
            "DiplomasFiscalizados": {
              "$ref": "#/definitions/TDiplomasFiscalizadosEmissora"
            },
            "IesEmissora": {
              "$ref": "#/definitions/TDadosIesEmissora"
            }
          },
          "required": [
            "DataInicioFiscalizacao",
            "IesEmissora",
            "DiplomasFiscalizados",
            "DataFimFiscalizacao"
          ],
          "type": "object"
        }
      },
      "required": [
        "Versao",
        "infArquivoFiscalizacaoEmissora"
      ],
      "type": "object"
    },
    "meta": {
      "description": "Metadados da lista de diplomas",
      "properties": {
        "clientId": {
          "description": "Identificador único universal do cliente do RAP",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-4[0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$",
          "type": "string"
        },
        "clientSignature": {
          "$comment": "Atributo ainda não tem funcionalidade, será usado em versões futuras",
          "description": "Assinatura do cliente do RAP",
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "dltId": {
          "const": "ethereum",
          "description": "Nome da DLT em que o documento assinado será registrado",
          "type": "string"
        },
        "docType": {
          "const": "audit_file_issuer",
          "description": "Identificador do tipo Arquivo de Fiscalização da Emissora no RAP",
          "type": "string"
        },
        "groupId": {
          "description": "Identificador único do grupo de documentos ao qual o documento faz parte",
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "isDocSigned": {
          "description": "Flag para indicar se o documento a ser registrado conterá assinaturas",
          "enum": [
            "true",
            "false"
          ],
          "type": "string"
        },
        "mimeType": {
          "description": "Tipo da mídia do Arquivo de Fiscalização da Emissora",
          "enum": [
            "application/xml",
            "text/xml"
          ],
          "type": "string"
        },
        "yourNumber": {
          "description": "Identificador único gerado pelo cliente do RAP",
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "clientId",
        "clientSignature",
        "docType",
        "groupId",
        "mimeType",
        "yourNumber"
      ],
      "type": "object"
    }
  },
  "required": [
    "meta",
    "data"
  ],
  "title": "Esquema JSON do Arquivo de Fiscalização da Emissora",
  "type": "object"
}
