{
  "$id": "http://example.com/CurriculoEscolar.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TAtoRegulatorioComOuSemEMEC": {
      "description": "Ato regulatório de reconhecimento",
      "oneOf": [
        {
          "properties": {
            "Data": {
              "description": "Data do ato regulatório",
              "format": "date"
            },
            "DataPublicacao": {
              "description": "Data de publicação do ato regulatório",
              "format": "date"
            },
            "Numero": {
              "description": "Número do ato regulatório",
              "pattern": "^(S/N)|(([0-9])[-0-9a-zA-Z0-9_/]*)$",
              "type": "string"
            },
            "NumeroDOU": {
              "description": "Número do ato regulatório no diário oficial da união",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "PaginaPublicacao": {
              "description": "Página de publicação do ato regulatório",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "SecaoPublicacao": {
              "description": "Seção de publicação do ato regulatório",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "Tipo": {
              "description": "Tipo do ato regulatório",
              "enum": [
                "Parecer",
                "Resolução",
                "Decreto",
                "Portaria",
                "Deliberação",
                "Lei Federal",
                "Lei Estadual",
                "Lei Municipal",
                "Ato Próprio"
              ],
              "type": "string"
            },
            "VeiculoPublicacao": {
              "description": "Veículo de publicação do ato regulatório",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            }
          },
          "required": [
            "Tipo",
            "Numero",
            "Data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "InformacoesTramitacaoEMEC": {
              "description": "Informações sobre a tramitação do processo e-MEC",
              "properties": {
                "DataCadastro": {
                  "description": "Data de abertura do processo e-MEC",
                  "format": "date"
                },
                "DataProtocolo": {
                  "description": "Data de emissão do protocolo e-MEC",
                  "format": "date"
                },
                "NumeroProcesso": {
                  "description": "Número do processo e-MEC",
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                },
                "TipoProcesso": {
                  "description": "Tipo do processo e-MEC",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                  "type": "string"
                }
              },
              "required": [
                "NumeroProcesso",
                "TipoProcesso",
                "DataCadastro",
                "DataProtocolo"
              ],
              "type": "object"
            }
          },
          "required": [
            "InformacoesTramitacaoEMEC"
          ],
          "type": "object"
        }
      ]
    },
    "TCNPJ": {
      "description": "Número do CNPJ sem separadores",
      "pattern": "^[0-9]{14}$",
      "type": "string"
    },
    "TCriterioLimitesCargas": {
      "description": "Lista de critérios de integralização",
      "properties": {
        "CargaHorariaMaxima": {
          "$ref": "#/definitions/THoraRelogio"
        },
        "CargaHorariaMinima": {
          "$ref": "#/definitions/THoraRelogio"
        },
        "CargaHorariaParaTotal": {
          "$ref": "#/definitions/THoraRelogio"
        }
      },
      "required": [
        "CargaHorariaMinima",
        "CargaHorariaMaxima"
      ],
      "type": "object"
    },
    "TDadosIesEmissora": {
      "description": "Dados da instituição de ensino superior emissora",
      "properties": {
        "CNPJ": {
          "description": "Número do CNPJ sem separadores",
          "pattern": "^[0-9]{14}$",
          "type": "string"
        },
        "CodigoMEC": {
          "description": "Código de identificação da instituição no MEC",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "Credenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "Endereco": {
          "$ref": "#/definitions/TEndereco"
        },
        "Mantenedora": {
          "properties": {
            "CNPJ": {
              "$ref": "#/definitions/TCNPJ"
            },
            "Endereco": {
              "$ref": "#/definitions/TEndereco"
            },
            "RazaoSocial": {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "Nome": {
          "description": "Nome completo da instituição",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Recredenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "RenovacaoDeRecredenciamento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        }
      },
      "required": [
        "Nome",
        "CodigoMEC",
        "CNPJ",
        "Endereco",
        "Credenciamento"
      ],
      "type": "object"
    },
    "TDadosMinimoCurso": {
      "description": "Dados do curso",
      "oneOf": [
        {
          "properties": {
            "CodigoCursoEMEC": {
              "description": "Código e-MEC do curso",
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          },
          "required": [
            "CodigoCursoEMEC"
          ]
        },
        {
          "properties": {
            "SemCodigoCursoEMEC": {
              "description": "Informações sobre a tramitação do processo e-MEC",
              "properties": {
                "DataCadastro": {
                  "description": "Data de cadastro do processo e-MEC",
                  "format": "date",
                  "type": "string"
                },
                "DataProtocolo": {
                  "description": "Data de protocolo do processo e-MEC",
                  "format": "date",
                  "type": "string"
                },
                "NumeroProcesso": {
                  "description": "Número do processo e-MEC",
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                },
                "TipoProcesso": {
                  "description": "Tipo do processo e-MEC",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                  "type": "string"
                }
              },
              "required": [
                "NumeroProcesso",
                "TipoProcesso",
                "DataCadastro",
                "DataProtocolo"
              ],
              "type": "object"
            }
          },
          "required": [
            "SemCodigoCursoEMEC"
          ]
        }
      ],
      "properties": {
        "Autorizacao": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "Habilitacao": {
          "$ref": "#/definitions/THabilitacao"
        },
        "NomeCurso": {
          "description": "Nome completo do curso",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Reconhecimento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "RenovacaoReconhecimento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        }
      },
      "required": [
        "NomeCurso",
        "Autorizacao",
        "Reconhecimento"
      ],
      "type": "object"
    },
    "TDadosMinimoCursoNSF": {
      "description": "Dados do curso NSF",
      "oneOf": [
        {
          "properties": {
            "CodigoCursoEMEC": {
              "description": "Código e-MEC do curso",
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          },
          "required": [
            "CodigoCursoEMEC"
          ]
        },
        {
          "properties": {
            "SemCodigoCursoEMEC": {
              "description": "Informações sobre a tramitação do processo e-MEC",
              "properties": {
                "DataCadastro": {
                  "description": "Data de cadastro do processo e-MEC",
                  "format": "date",
                  "type": "string"
                },
                "DataProtocolo": {
                  "description": "Data de protocolo do processo e-MEC",
                  "format": "date",
                  "type": "string"
                },
                "NumeroProcesso": {
                  "description": "Número do processo e-MEC",
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                },
                "TipoProcesso": {
                  "description": "Tipo do processo e-MEC",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
                  "type": "string"
                }
              },
              "required": [
                "NumeroProcesso",
                "TipoProcesso",
                "DataCadastro",
                "DataProtocolo"
              ],
              "type": "object"
            }
          },
          "required": [
            "SemCodigoCursoEMEC"
          ]
        }
      ],
      "properties": {
        "Autorizacao": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "Habilitacao": {
          "$ref": "#/definitions/THabilitacao"
        },
        "NomeCurso": {
          "description": "Nome completo do curso",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Reconhecimento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        },
        "RenovacaoReconhecimento": {
          "$ref": "#/definitions/TAtoRegulatorioComOuSemEMEC"
        }
      },
      "required": [
        "NomeCurso"
      ],
      "type": "object"
    },
    "TEndereco": {
      "allOf": [
        {
          "$ref": "#/definitions/TMunicipio"
        }
      ],
      "description": "Dados de localização",
      "properties": {
        "Bairro": {
          "description": "Região do município",
          "maxLength": 60,
          "minLength": 2,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "CEP": {
          "description": "Código Postal",
          "pattern": "^[0-9]{8}$",
          "type": "string"
        },
        "Complemento": {
          "description": "Identificação da unidade",
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Logradouro": {
          "description": "Nome do local",
          "maxLength": 150,
          "minLength": 2,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "Numero": {
          "description": "Número da casa ou edifício",
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        }
      },
      "required": [
        "Logradouro",
        "Bairro",
        "CEP"
      ],
      "type": "object"
    },
    "THabilitacao": {
      "description": "Habilitação do curso",
      "items": {
        "properties": {
          "DataHabilitacao": {
            "format": "date"
          },
          "NomeHabilitacao": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
            "type": "string"
          }
        },
        "required": [
          "NomeHabilitacao",
          "DataHabilitacao"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "THoraAula": {
      "description": "Carga horária em número inteiro",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "THoraRelogio": {
      "description": "Carga horária em número decimal",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "type": "string"
    },
    "TMunicipio": {
      "description": "Dados do município",
      "properties": {
        "CodigoMunicipio": {
          "description": "Código do município da tabela do IBGE",
          "pattern": "^[0-9]{7}$",
          "type": "string"
        },
        "NomeMunicipio": {
          "description": "Nome completo do município",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}$",
          "type": "string"
        },
        "UF": {
          "$ref": "#/definitions/TUF"
        }
      },
      "required": [
        "CodigoMunicipio",
        "NomeMunicipio",
        "UF"
      ],
      "type": "object"
    },
    "TTipoUnidadeCurricular": {
      "description": "Tipos de unidade curricular",
      "enum": [
        "Disciplina",
        "Módulo",
        "Atividade",
        "Estágio",
        "Trabalho de Conclusão de Curso",
        "Monografia",
        "Artigo",
        "Projeto",
        "Produto",
        "Atividade Complementar",
        "Atividade de Extensão"
      ],
      "type": "string"
    },
    "TUF": {
      "description": "Sigla da unidade federativa",
      "enum": [
        "AC",
        "AL",
        "AM",
        "AP",
        "BA",
        "CE",
        "DF",
        "ES",
        "GO",
        "MA",
        "MG",
        "MS",
        "MT",
        "PA",
        "PB",
        "PE",
        "PI",
        "PR",
        "RJ",
        "RN",
        "RO",
        "RR",
        "RS",
        "SC",
        "SE",
        "SP",
        "TO"
      ],
      "type": "string"
    }
  },
  "description": "Esquema JSON para Validação de Currículos Escolares, Versão 1.05",
  "properties": {
    "data": {
      "description": "Dados do currículo escolar",
      "properties": {
        "Versao": {
          "const": "1.05",
          "description": "Versão do leiaute do Currículo Escolar",
          "type": "string"
        },
        "ambiente": {
          "description": "Tipo do ambiente em que o Currículo Escolar foi emitido",
          "enum": [
            "Produção",
            "Homologação"
          ],
          "type": "string"
        },
        "infCurriculoEscolar": {
          "description": "Informações do Currículo Escolar",
          "oneOf": [
            {
              "properties": {
                "DadosCurso": {
                  "$ref": "#/definitions/TDadosMinimoCurso"
                }
              },
              "required": [
                "DadosCurso"
              ]
            },
            {
              "properties": {
                "DadosCursoNSF": {
                  "$ref": "#/definitions/TDadosMinimoCursoNSF"
                }
              },
              "required": [
                "DadosCursoNSF"
              ]
            }
          ],
          "properties": {
            "CodigoCurriculo": {
              "description": "Código do currículo usado internamente pela IES para referenciá-lo",
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "DataCurriculo": {
              "description": "Data do currículo no formato AAAA-MM-DD",
              "format": "date",
              "type": "string"
            },
            "IesEmissora": {
              "$ref": "#/definitions/TDadosIesEmissora"
            },
            "InformacoesAdicionais": {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            "MinutosRelogioDaHoraAula": {
              "description": "Quantos minutos-relógio tem uma hora aula neste currículo",
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "NomeParaAreas": {
              "description": "Áreas de Concentração previstas pelo Projeto Pedagógico do Curso (PPC)",
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "infAreas": {
              "description": "Tipo que define informações sobre as áreas usadas neste currículo",
              "items": {
                "properties": {
                  "Area": {
                    "properties": {
                      "Codigo": {
                        "items": {
                          "maxLength": 255,
                          "minLength": 1,
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array"
                      },
                      "Nome": {
                        "items": {
                          "maxLength": 255,
                          "minLength": 1,
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array"
                      }
                    },
                    "required": [
                      "Codigo",
                      "Nome"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "Area"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "infCriteriosIntegralizacao": {
              "description": "Lista de critérios de integralização",
              "items": {
                "properties": {
                  "CriterioIntegralizacao": {
                    "oneOf": [
                      {
                        "properties": {
                          "CriterioIntegralizacaoRotulos": {
                            "properties": {
                              "CargasHorariasCriterio": {
                                "$ref": "#/definitions/TCriterioLimitesCargas"
                              },
                              "Codigo": {
                                "maxLength": 255,
                                "minLength": 0,
                                "type": "string"
                              },
                              "Etiquetas": {
                                "items": {
                                  "properties": {
                                    "Etiqueta": {
                                      "maxLength": 255,
                                      "minLength": 0,
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "Etiqueta"
                                  ],
                                  "type": "object"
                                },
                                "minItems": 1,
                                "type": "array"
                              },
                              "UnidadeCurricular": {
                                "$ref": "#/definitions/TTipoUnidadeCurricular"
                              }
                            },
                            "required": [
                              "Codigo",
                              "CargasHorariasCriterio"
                            ],
                            "type": "object"
                          }
                        },
                        "required": [
                          "CriterioIntegralizacaoRotulos"
                        ]
                      },
                      {
                        "properties": {
                          "CriterioIntegralizacaoExpressao": {
                            "properties": {
                              "CargasHorariasCriterio": {
                                "$ref": "#/definitions/TCriterioLimitesCargas"
                              },
                              "Codigo": {
                                "maxLength": 255,
                                "minLength": 0,
                                "type": "string"
                              },
                              "Expressao": {
                                "properties": {
                                  "Soma": {
                                    "items": {
                                      "properties": {
                                        "Codigo": {
                                          "maxLength": 255,
                                          "minLength": 0,
                                          "type": "string"
                                        }
                                      },
                                      "required": [
                                        "Codigo"
                                      ],
                                      "type": "object"
                                    },
                                    "minItems": 1,
                                    "type": "array"
                                  }
                                },
                                "required": [
                                  "Soma"
                                ],
                                "type": "object"
                              }
                            },
                            "required": [
                              "Codigo",
                              "Expressao",
                              "CargasHorariasCriterio"
                            ],
                            "type": "object"
                          }
                        },
                        "required": [
                          "CriterioIntegralizacaoExpressao"
                        ]
                      }
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "CriterioIntegralizacao"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "infEstruturaAtividadesComplementares": {
              "description": "Tipo que define a estruturação das atividades complementares que compõe a estrutura curricular do curso",
              "items": {
                "properties": {
                  "Categoria": {
                    "properties": {
                      "Atividades": {
                        "items": {
                          "properties": {
                            "Atividade": {
                              "properties": {
                                "Codigo": {
                                  "maxLength": 255,
                                  "minLength": 0,
                                  "type": "string"
                                },
                                "Descricao": {
                                  "maxLength": 5000,
                                  "minLength": 0,
                                  "type": "string"
                                },
                                "LimiteCargaHorariaEmHoraRelogio": {
                                  "$ref": "#/definitions/THoraRelogio"
                                },
                                "Nome": {
                                  "maxLength": 255,
                                  "minLength": 0,
                                  "type": "string"
                                }
                              },
                              "required": [
                                "Codigo",
                                "Nome",
                                "LimiteCargaHorariaEmHoraRelogio"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "Atividade"
                          ],
                          "type": "object"
                        },
                        "minItems": 1,
                        "type": "array"
                      },
                      "Codigo": {
                        "maxLength": 255,
                        "minLength": 0,
                        "type": "string"
                      },
                      "LimiteCargaHorariaEmHoraRelogio": {
                        "$ref": "#/definitions/THoraRelogio"
                      },
                      "Nome": {
                        "maxLength": 255,
                        "minLength": 0,
                        "type": "string"
                      }
                    },
                    "required": [
                      "Codigo",
                      "Nome",
                      "Atividades"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "Categoria"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "infEstruturaCurricular": {
              "description": "Tipo que define as unidades que compõe a estrutura curricular do curso",
              "items": {
                "properties": {
                  "UnidadeCurricular": {
                    "properties": {
                      "Areas": {
                        "description": "Áreas/ênfases associadas a Unidade Curricular",
                        "items": {
                          "properties": {
                            "Area": {
                              "properties": {
                                "Codigo": {
                                  "maxLength": 255,
                                  "minLength": 1,
                                  "type": "string"
                                }
                              },
                              "required": [
                                "Codigo"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "Area"
                          ],
