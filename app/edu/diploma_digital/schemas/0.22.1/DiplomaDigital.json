            "Tipo": {
              "description": "Tipo do ato regulatório",
              "enum": [
                "Parecer",
                "Resolução",
                "Decreto",
                "Portaria",
                "Deliberação",
                "Despacho",
                "Lei Federal",
                "Lei Estadual",
                "Lei Municipal",
                "Ato Próprio"
