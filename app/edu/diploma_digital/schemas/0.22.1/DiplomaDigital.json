  "description": "Esquema JSON para Validação de Diplomas Digitais, Versão 1.05",
  "properties": {
    "data": {
      "description": "Dados do diploma digital",
      "properties": {
        "Versao": {
          "const": "1.05",
          "description": "Versão do leiaute do diploma digital",
          "type": "string"
        },
        "ambiente": {
          "description": "Tipo do ambiente em que o diploma foi emitido",
          "enum": [
            "Produção",
            "Homologação"
          ],
          "type": "string"
        },
        "infDiploma": {
          "description": "Informações do diploma digital",
          "oneOf": [
            {
              "allOf": [
                {
                  "oneOf": [
                    {
                      "properties": {
                        "DadosDiploma": {
                          "$ref": "#/definitions/TDadosDiploma"
                        }
                      },
                      "required": [
                        "DadosDiploma"
                      ]
                    },
                    {
                      "properties": {
                        "DadosDiplomaNSF": {
                          "$ref": "#/definitions/TDadosDiploma"
                        }
                      },
                      "required": [
                        "DadosDiplomaNSF"
                      ]
                    }
                  ]
                },
                {
                  "oneOf": [
                    {
                      "properties": {
                        "DadosRegistro": {
                          "$ref": "#/definitions/TDadosRegistro"
                        }
                      },
                      "required": [
                        "DadosRegistro"
                      ]
                    },
                    {
                      "properties": {
                        "DadosRegistroNSF": {
                          "$ref": "#/definitions/TDadosRegistroNSF"
                        }
                      },
                      "required": [
                        "DadosRegistroNSF"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "properties": {
                "DadosDiplomaPorDecisaoJudicial": {
                  "$ref": "#/definitions/TDadosDiplomaPorDecisaoJudicial"
                },
                "DadosRegistroPorDecisaoJudicial": {
                  "$ref": "#/definitions/TDadosRegistroPorDecisaoJudicial"
                }
              },
              "required": [
                "DadosDiplomaPorDecisaoJudicial",
                "DadosRegistroPorDecisaoJudicial"
              ]
            }
          ],
          "type": "object"
        }
      },
      "required": [
