# Definir o comportamento padrão para normalizar todos os arquivos de texto para LF
* text=auto eol=lf

# Forçar tipos específicos de arquivos para sempre usarem LF
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.env.dev.sample text eol=lf
*.svg text eol=lf

# Manter arquivos binários intactos
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.sqlite3 binary
*.db binary

# 7. Django/Python Específicos
*.po text eol=lf
*.mo binary

# Logs e Cache
*.log text eol=lf
