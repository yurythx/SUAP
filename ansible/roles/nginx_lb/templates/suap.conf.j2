map $http_x_forwarded_proto $suap_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
server {
    listen 80 default_server;
    server_name {{ suap_server_names }};
    client_max_body_size 100m;
    set_real_ip_from {{ suap_proxy_ip }};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    location / {
        proxy_pass http://{{ suap_app_ip }}:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $suap_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 300;
    }
    location /static/ {
        alias /var/www/suap-static/;
        expires 7d;
    }
}
