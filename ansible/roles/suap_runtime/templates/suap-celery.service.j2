[Unit]
Description=SUAP Celery worker
After=network.target

[Service]
Type=simple
User=suap
Group=suap
WorkingDirectory={{ suap_code_dir }}
EnvironmentFile={{ suap_code_dir }}/.env
Environment=DJANGO_SETTINGS_MODULE=suap.settings
Environment=PYTHONPATH={{ suap_code_dir }}
ExecStart={{ suap_code_dir }}/.venv/bin/celery -A suap worker --loglevel=INFO --concurrency={{ celery_concurrency }} -Q geral
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
