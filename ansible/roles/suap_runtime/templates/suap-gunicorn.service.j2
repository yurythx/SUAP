[Unit]
Description=SUAP Gunicorn
After=network.target

[Service]
Type=simple
User=suap
Group=suap
WorkingDirectory={{ suap_code_dir }}
EnvironmentFile={{ suap_code_dir }}/.env
Environment=DJANGO_SETTINGS_MODULE=suap.settings
Environment=PYTHONPATH={{ suap_code_dir }}
ExecStart={{ suap_code_dir }}/.venv/bin/gunicorn suap.wsgi:application --bind {{ suap_bind }} --workers {{ gunicorn_workers }} --threads {{ gunicorn_threads }} --timeout 120 --access-logfile - --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
