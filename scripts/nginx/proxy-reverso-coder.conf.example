# Exemplo para um vhost do órgão Coder no proxy 192.168.0.218.
# Ainda não está aplicado. Não aponta para o balanceador da prefeitura (192.168.29.110).
# Preencher o nome e o endereço do balanceador deste órgão quando as máquinas existirem.

server {
    listen 80;
    server_name PREENCHER-DOMINIO-DO-CODER;

    location / {
        proxy_pass http://PREENCHER-IP-DO-BALANCEADOR-CODER;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }
}
