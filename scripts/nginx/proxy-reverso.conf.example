# Exemplo para o Nginx do proxy 192.168.0.218.
# Ainda não está aplicado. O certificado entra quando o vhost for publicado.
# O balanceador interno (192.168.29.110) já aceita estes Host e repassa
# X-Forwarded-Proto e X-Forwarded-For.

server {
    listen 80;
    server_name hmlsuap.rondonopolis.mt.gov.br;

    location / {
        proxy_pass http://192.168.29.110;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }
}

