[Unit]
Description=SUAP Celery beat
After=network.target suap-celery.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/suap/src
EnvironmentFile=/opt/suap/src/.env
Environment=DJANGO_SETTINGS_MODULE=suap.settings
Environment=PYTHONPATH=/opt/suap/src
ExecStart=/opt/suap/src/.venv/bin/celery -A suap beat --loglevel=INFO --scheduler django_celery_beat.schedulers:DatabaseScheduler
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
