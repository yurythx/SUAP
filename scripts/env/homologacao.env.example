# Homologação — copiar para /opt/suap/src/.env no suap-app e preencher os segredos.
# O nome público é publicado no proxy 192.168.0.218. O acesso por IP interno permanece válido.

DEBUG=False
DISABLE_EDU=True
RUN_SYNC_ON_START=True
SECRET_KEY=troque-por-openssl-rand-hex-64
SITE_URL=https://hmlsuap.rondonopolis.mt.gov.br
SERVER_ALIAS=suap-hml
ALLOWED_HOSTS=hmlsuap.rondonopolis.mt.gov.br,192.168.29.110,192.168.110.10,192.168.110.20,localhost
CSRF_TRUSTED_ORIGINS=https://hmlsuap.rondonopolis.mt.gov.br,http://192.168.29.110,http://192.168.110.10
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
TIME_ZONE=America/Sao_Paulo
DJANGO_SETTINGS_MODULE=suap.settings

DATABASE_NAME=suap
DATABASE_USER=suap
DATABASE_PASSWORD=troque-senha-forte-postgres
DATABASE_HOST=192.168.110.30
DATABASE_PORT=5432
DB_CONN_MAX_AGE=60

USE_REDIS=True
REDIS_HOST=192.168.110.40
REDIS_PORT=6379
REDIS_PASSWORD=troque-senha-forte-redis
REDIS_LOCATION=redis://:troque-senha-forte-redis@192.168.110.40:6379/1
SESSION_LOCATION=redis://:troque-senha-forte-redis@192.168.110.40:6379/2

USE_CELERY=True
CELERY_BROKER_URL=redis://:troque-senha-forte-redis@192.168.110.40:6379/3
CELERY_RESULT_BACKEND=redis://:troque-senha-forte-redis@192.168.110.40:6379/4
CELERY_QUEUE=geral
CELERY_CONCURRENCY=2

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
USE_SENTRY=False
LOG_LEVEL=INFO
