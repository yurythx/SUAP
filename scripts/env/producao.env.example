# Produção — usar somente quando existir o conjunto de máquinas de produção.
# Não aponta para os LXC de homologação. Preencha hosts e segredos nessa ocasião.

DEBUG=False
DISABLE_EDU=True
RUN_SYNC_ON_START=True
SECRET_KEY=troque-por-openssl-rand-hex-64
SITE_URL=https://suap.rondonopolis.mt.gov.br
SERVER_ALIAS=suap-prod
ALLOWED_HOSTS=suap.rondonopolis.mt.gov.br
CSRF_TRUSTED_ORIGINS=https://suap.rondonopolis.mt.gov.br
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
TIME_ZONE=America/Sao_Paulo
DJANGO_SETTINGS_MODULE=suap.settings

DATABASE_NAME=suap
DATABASE_USER=suap
DATABASE_PASSWORD=troque-senha-forte-postgres
DATABASE_HOST=preencher-ip-do-banco-de-producao
DATABASE_PORT=5432
DB_CONN_MAX_AGE=60

USE_REDIS=True
REDIS_HOST=preencher-ip-do-redis-de-producao
REDIS_PORT=6379
REDIS_PASSWORD=troque-senha-forte-redis
REDIS_LOCATION=redis://:troque-senha-forte-redis@preencher-ip-do-redis-de-producao:6379/1
SESSION_LOCATION=redis://:troque-senha-forte-redis@preencher-ip-do-redis-de-producao:6379/2

USE_CELERY=True
CELERY_BROKER_URL=redis://:troque-senha-forte-redis@preencher-ip-do-redis-de-producao:6379/3
CELERY_RESULT_BACKEND=redis://:troque-senha-forte-redis@preencher-ip-do-redis-de-producao:6379/4
CELERY_QUEUE=geral
CELERY_CONCURRENCY=2

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
USE_SENTRY=False
LOG_LEVEL=INFO
