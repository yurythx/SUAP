# Órgão Coder — outro órgão, separado da Prefeitura Municipal de Rondonópolis.
# Copiar para o .env da aplicação DESTE órgão, depois de existir o conjunto de máquinas dele.
# Não usar os IPs 192.168.110.0/24 nem o banco 192.168.110.30: esse conjunto é a prefeitura.

SUAP_ORGAO=coder
DEBUG=False
DISABLE_EDU=True
RUN_SYNC_ON_START=True
SECRET_KEY=troque-por-openssl-rand-hex-64
SITE_URL=https://PREENCHER-DOMINIO-DO-CODER
SERVER_ALIAS=suap-coder
ALLOWED_HOSTS=PREENCHER-DOMINIO-DO-CODER
CSRF_TRUSTED_ORIGINS=https://PREENCHER-DOMINIO-DO-CODER
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
TIME_ZONE=America/Sao_Paulo
DJANGO_SETTINGS_MODULE=suap.settings

DATABASE_NAME=suap
DATABASE_USER=suap
DATABASE_PASSWORD=troque-senha-forte-postgres
DATABASE_HOST=PREENCHER-IP-DO-BANCO-CODER
DATABASE_PORT=5432
DB_CONN_MAX_AGE=60

USE_REDIS=True
REDIS_HOST=PREENCHER-IP-DO-REDIS-CODER
REDIS_PORT=6379
REDIS_PASSWORD=troque-senha-forte-redis
REDIS_LOCATION=redis://:troque-senha-forte-redis@PREENCHER-IP-DO-REDIS-CODER:6379/1
SESSION_LOCATION=redis://:troque-senha-forte-redis@PREENCHER-IP-DO-REDIS-CODER:6379/2

USE_CELERY=True
CELERY_BROKER_URL=redis://:troque-senha-forte-redis@PREENCHER-IP-DO-REDIS-CODER:6379/3
CELERY_RESULT_BACKEND=redis://:troque-senha-forte-redis@PREENCHER-IP-DO-REDIS-CODER:6379/4
CELERY_QUEUE=geral
CELERY_CONCURRENCY=2

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
USE_SENTRY=False
LOG_LEVEL=INFO
