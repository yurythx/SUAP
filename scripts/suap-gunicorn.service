[Unit]
Description=SUAP Gunicorn
After=network.target

[Service]
Type=simple
User=suap
Group=suap
WorkingDirectory=/opt/suap/src
EnvironmentFile=/opt/suap/src/.env
Environment=DJANGO_SETTINGS_MODULE=suap.settings
Environment=PYTHONPATH=/opt/suap/src
ExecStart=/opt/suap/src/.venv/bin/gunicorn suap.wsgi:application --bind 192.168.110.20:8000 --workers 2 --threads 2 --timeout 120 --access-logfile - --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
