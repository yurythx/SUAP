# NÃO copiar este arquivo por cima de terraform/terraform.tfvars.
# Aquele arquivo e o state ao lado descrevem a prefeitura (VMID a partir de 2100,
# rede 192.168.110.0/24). Aplicar esta malha no mesmo state alteraria os LXC que
# já estão no ar.
#
# Quando for criar o órgão Coder, use outro diretório de Terraform e outro state,
# com vmid_base e IPs novos. Os valores abaixo são só o formato.

proxmox_endpoint  = "https://192.168.29.51:8006/"
proxmox_insecure  = true
proxmox_api_token = "terraform-prov@pve!terraform-token=UUID"

proxmox_node      = "pve"
datastore_id      = "local-lvm"
template_debian13 = "local:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst"

bridge              = "PREENCHER-BRIDGE"
gateway             = "PREENCHER-GATEWAY"
dns_servers         = ["192.168.0.101", "1.1.1.1"]
dns_domain          = "PREENCHER-DOMINIO-DO-CODER"

ssh_public_key_path = "~/.ssh/id_ed25519_sei_homolog.pub"
root_password       = "DEFINIR_SENHA_FORTE"

vmid_base        = 2200
memory_budget_mb = 10240
