# =============================================================================
# SUAP oficial IFRN 4.x — produção (Autarquia)
# cp .env.example .env  e preencha os segredos
# =============================================================================

SUAP_IMAGE=suap:prod
SUAP_ENVIRONMENT=production
DEBUG=False
DISABLE_EDU=True
RUN_SYNC_ON_START=True

SECRET_KEY=troque-por-openssl-rand-hex-64
SITE_URL=https://suap.rondonopolis.mt.gov.br
SERVER_ALIAS=suap-prod
ALLOWED_HOSTS=suap.rondonopolis.mt.gov.br
CSRF_TRUSTED_ORIGINS=https://suap.rondonopolis.mt.gov.br
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
TIME_ZONE=America/Sao_Paulo

HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL 18 ---
DATABASE_NAME=suap
DATABASE_USER=suap
DATABASE_PASSWORD=troque-senha-forte-postgres
DATABASE_HOST=db
DATABASE_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis ---
USE_REDIS=True
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=troque-senha-forte-redis
REDIS_MAXMEMORY=1gb
REDIS_LOCATION=redis://:troque-senha-forte-redis@redis:6379/1
SESSION_LOCATION=redis://:troque-senha-forte-redis@redis:6379/2

# --- Celery ---
USE_CELERY=True
CELERY_BROKER_URL=redis://:troque-senha-forte-redis@redis:6379/3
CELERY_RESULT_BACKEND=redis://:troque-senha-forte-redis@redis:6379/4
CELERY_QUEUE=geral
CELERY_CONCURRENCY=4

# --- Gunicorn ---
GUNICORN_WORKERS=6
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# --- Volumes no host ---
SUAP_POSTGRES_HOST_PATH=../data/postgres
SUAP_REDIS_HOST_PATH=../data/redis
SUAP_TLS_HOST_PATH=../data/tls

# --- E-mail ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@autarquia.local

# --- Observabilidade ---
USE_SENTRY=False
SENTRY_URL=
LOG_LEVEL=INFO
